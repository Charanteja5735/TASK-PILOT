<!-- Toast container -->
<div class="toasts" id="toasts" data-testid="toasts"></div>

<script>
/* =========================================================
   TaskPilot — Vanilla JS (in-memory state)
   ========================================================= */

/* ---- In-memory state ---- */
const state = {
  user: null,            // { name, email, username }
  registered: [],        // [{ name, email, username, password }]
  tasks: [],             // [{ id, title, category, priority, due, done }]
  filter: 'All',
  editingId: null,
};

/* ---- Routing (page switching) ---- */
function navigate(page, e) {
  if (e) e.preventDefault();
  // Guard: dashboard requires auth
  if (page === 'dashboard' && !state.user) {
    showToast('error', 'Please sign in first', 'You need an account to access the dashboard.');
    page = 'login';
  }
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById('page-' + page);
  if (target) target.classList.add('active');

  document.querySelectorAll('#navMenu a').forEach(a => {
    a.classList.toggle('active', a.dataset.page === page);
  });
  // Close mobile menu
  document.getElementById('navMenu').classList.remove('open');
  window.scrollTo({ top: 0, behavior: 'smooth' });
  window.location.hash = page;
}

function toggleNav() {
  document.getElementById('navMenu').classList.toggle('open');
}

/* ---- Password toggle ---- */
function togglePass(id, btn) {
  const input = document.getElementById(id);
  const icon = btn.querySelector('i');
  if (input.type === 'password') {
    input.type = 'text';
    icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash');
  } else {
    input.type = 'password';
    icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye');
  }
}

/* ---- Toasts ---- */
function showToast(type, title, desc = '') {
  const ic = type === 'success' ? 'fa-check' : type === 'error' ? 'fa-triangle-exclamation' : 'fa-circle-info';
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.setAttribute('data-testid', `toast-${type}`);
  el.innerHTML = `
    <div class="ic"><i class="fa-solid ${ic}"></i></div>
    <div class="msg"><div class="t">${title}</div>${desc ? `<div class="d">${desc}</div>` : ''}</div>
  `;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 350); }, 3200);
}

/* ---- Validation helpers ---- */
function setErr(id, msg) { document.getElementById('err-' + id).textContent = msg || ''; }
function clearErrs(ids) { ids.forEach(i => setErr(i, '')); }
const emailRx = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

/* ---- Register ---- */
document.getElementById('registerForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const pass = document.getElementById('regPass').value;
  const conf = document.getElementById('regConfirm').value;

  clearErrs(['regName', 'regEmail', 'regPass', 'regConfirm']);
  let ok = true;
  if (name.length < 2)  { setErr('regName', 'Please enter your full name.'); ok = false; }
  if (!emailRx.test(email)) { setErr('regEmail', 'Enter a valid email address.'); ok = false; }
  if (pass.length < 6)  { setErr('regPass', 'Password must be at least 6 characters.'); ok = false; }
  if (pass !== conf)    { setErr('regConfirm', 'Passwords do not match.'); ok = false; }
  if (state.registered.some(u => u.email === email)) {
    setErr('regEmail', 'An account with this email already exists.'); ok = false;
  }
  if (!ok) { showToast('error', 'Please fix the highlighted fields'); return; }

  const username = email.split('@')[0];
  state.registered.push({ name, email, username, password: pass });
  state.user = { name, email, username };
  document.getElementById('userName').textContent = name.split(' ')[0];
  showToast('success', 'Account created', `Welcome aboard, ${name.split(' ')[0]}!`);
  e.target.reset();
  navigate('dashboard');
});

/* ---- Login ---- */
document.getElementById('loginForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const u = document.getElementById('loginUser').value.trim();
  const p = document.getElementById('loginPass').value;

  clearErrs(['loginUser', 'loginPass']);
  let ok = true;
  if (!u) { setErr('loginUser', 'Username is required.'); ok = false; }
  if (!p) { setErr('loginPass', 'Password is required.'); ok = false; }
  if (!ok) return;

  // Find by username OR email
  const found = state.registered.find(x =>
    (x.username === u || x.email === u) && x.password === p
  );

  // Demo: allow demo / demo123 even without registering
  if (!found && u === 'demo' && p === 'demo123') {
    state.user = { name: 'Demo Pilot', email: 'demo@taskpilot.app', username: 'demo' };
  } else if (!found) {
    setErr('loginPass', 'Invalid username or password.');
    showToast('error', 'Could not sign you in', 'Check your credentials and try again.');
    return;
  } else {
    state.user = { name: found.name, email: found.email, username: found.username };
  }

  document.getElementById('userName').textContent = state.user.name.split(' ')[0];
  showToast('success', `Welcome back, ${state.user.name.split(' ')[0]}!`);
  e.target.reset();
  navigate('dashboard');
});

function logout() {
  state.user = null;
  state.tasks = [];
  renderTasks();
  showToast('info', 'Signed out', 'See you again soon.');
  navigate('home');
}

/* ---- Tasks CRUD ---- */
function uid() { return Math.random().toString(36).slice(2, 10); }

document.getElementById('taskForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const title = document.getElementById('taskTitle').value.trim();
  const category = document.getElementById('taskCategory').value;
  const priority = document.getElementById('taskPriority').value;
  const due = document.getElementById('taskDue').value;

  if (!title) { showToast('error', 'Task title required'); return; }

  if (state.editingId) {
    const t = state.tasks.find(x => x.id === state.editingId);
    if (t) { t.title = title; t.category = category; t.priority = priority; t.due = due; }
    showToast('success', 'Task updated');
    cancelEdit();
  } else {
    state.tasks.unshift({
      id: uid(), title, category, priority, due, done: false,
      createdAt: new Date().toISOString(),
    });
    showToast('success', 'Task added', `“${title}” added to your board.`);
  }

  document.getElementById('taskForm').reset();
  document.getElementById('taskCategory').value = 'Work';
  document.getElementById('taskPriority').value = 'Medium';
  renderTasks();
});

function cancelEdit() {
  state.editingId = null;
  document.getElementById('taskSubmitLabel').textContent = 'Add task';
  document.getElementById('taskCancelBtn').style.display = 'none';
  document.getElementById('taskForm').reset();
  document.getElementById('taskCategory').value = 'Work';
  document.getElementById('taskPriority').value = 'Medium';
}

function editTask(id) {
  const t = state.tasks.find(x => x.id === id);
  if (!t) return;
  state.editingId = id;
  document.getElementById('taskTitle').value = t.title;
  document.getElementById('taskCategory').value = t.category;
  document.getElementById('taskPriority').value = t.priority;
  document.getElementById('taskDue').value = t.due || '';
  document.getElementById('taskSubmitLabel').textContent = 'Save changes';
  document.getElementById('taskCancelBtn').style.display = 'inline-flex';
  document.getElementById('taskTitle').focus();
}

function deleteTask(id) {
  state.tasks = state.tasks.filter(t => t.id !== id);
  renderTasks();
  showToast('info', 'Task deleted');
}

function toggleDone(id) {
  const t = state.tasks.find(x => x.id === id);
  if (!t) return;
  t.done = !t.done;
  renderTasks();
  if (t.done) showToast('success', 'Nice work', `“${t.title}” completed.`);
}

function setFilter(f) {
  state.filter = f;
  document.querySelectorAll('.task-filters .chip').forEach(c => {
    c.classList.toggle('active', c.dataset.filter === f);
  });
  renderTasks();
}

function priorityPill(p) {
  if (p === 'High')   return `<span class="pill pill-high">High</span>`;
  if (p === 'Medium') return `<span class="pill pill-med">Medium</span>`;
  return `<span class="pill pill-low">Low</span>`;
}

function fmtDate(d) {
  if (!d) return '';
  try {
    const dt = new Date(d + 'T00:00:00');
    return dt.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  } catch (e) { return d; }
}

function renderTasks() {
  const list = document.getElementById('taskList');
  const visible = state.tasks.filter(t => state.filter === 'All' || t.category === state.filter);

  if (!visible.length) {
    list.innerHTML = `
      <div class="empty" data-testid="task-list-empty">
        <i class="fa-regular fa-circle-check" style="font-size:22px; color:var(--text-dim);"></i>
        <div style="margin-top:8px;">No tasks here yet. Add your first task above.</div>
      </div>`;
    return;
  }

  list.innerHTML = visible.map(t => `
    <div class="task ${t.done ? 'done' : ''}" data-testid="task-item" data-id="${t.id}">
      <div class="check" onclick="toggleDone('${t.id}')" data-testid="task-toggle" title="Mark complete">
        ${t.done ? '<i class="fa-solid fa-check"></i>' : ''}
      </div>
      <div>
        <div class="title">${escapeHtml(t.title)}</div>
        <div class="meta-row">
          <span class="cat">${t.category}</span>
          ${priorityPill(t.priority)}
          ${t.due ? `<span class="date"><i class="fa-regular fa-calendar"></i> ${fmtDate(t.due)}</span>` : ''}
        </div>
      </div>
      <div class="actions">
        <button onclick="editTask('${t.id}')" data-testid="task-edit" title="Edit"><i class="fa-regular fa-pen-to-square"></i></button>
        <button class="del" onclick="deleteTask('${t.id}')" data-testid="task-delete" title="Delete"><i class="fa-regular fa-trash-can"></i></button>
      </div>
    </div>
  `).join('');
}

function escapeHtml(s) {
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ---- Pomodoro ---- */
const POMO = {
  modes: { focus: 25 * 60, short: 5 * 60, long: 15 * 60 },
  mode: 'focus',
  remaining: 25 * 60,
  timer: null,
  sessions: 0,
  circumference: 2 * Math.PI * 88, // r=88
};

function pomoFormat(s) {
  const m = Math.floor(s / 60).toString().padStart(2, '0');
  const sec = (s % 60).toString().padStart(2, '0');
  return `${m}:${sec}`;
}

function pomoUpdateRing() {
  const total = POMO.modes[POMO.mode];
  const pct = POMO.remaining / total;
  const offset = POMO.circumference * (1 - pct);
  document.getElementById('pomoProg').setAttribute('stroke-dashoffset', offset);
  document.getElementById('pomoTime').textContent = pomoFormat(POMO.remaining);
}

function pomoStart() {
  if (POMO.timer) return;
  POMO.timer = setInterval(() => {
    POMO.remaining = Math.max(0, POMO.remaining - 1);
    pomoUpdateRing();
    if (POMO.remaining === 0) {
      clearInterval(POMO.timer); POMO.timer = null;
      if (POMO.mode === 'focus') {
        POMO.sessions += 1;
        document.getElementById('pomoCount').textContent = POMO.sessions;
        showToast('success', 'Focus session complete', 'Take a short break — you earned it.');
      } else {
        showToast('info', 'Break over', 'Time to refocus.');
      }
    }
  }, 1000);
  showToast('info', 'Timer started');
}

function pomoPause() {
  if (POMO.timer) { clearInterval(POMO.timer); POMO.timer = null; showToast('info', 'Timer paused'); }
}

function pomoReset() {
  pomoPause();
  POMO.remaining = POMO.modes[POMO.mode];
  pomoUpdateRing();
}

function pomoSetMode(m) {
  POMO.mode = m;
  document.querySelectorAll('.pomo-modes .chip').forEach(c => {
    c.classList.toggle('active', c.dataset.mode === m);
  });
  document.getElementById('pomoMode').textContent =
    m === 'focus' ? 'Focus session' : m === 'short' ? 'Short break' : 'Long break';
  pomoReset();
}

/* ---- Init ---- */
function initHashRoute() {
  const h = (window.location.hash || '#home').replace('#', '');
  if (['home','login','register','dashboard'].includes(h)) navigate(h);
  else navigate('home');
}

function initToday() {
  const d = new Date();
  const s = d.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
  document.getElementById('todayLabel').textContent = `${s} · Let's make today productive.`;
}

window.addEventListener('DOMContentLoaded', () => {
  initToday();
  pomoUpdateRing();
  renderTasks();
  initHashRoute();
});
</script>
