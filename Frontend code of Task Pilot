<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>TaskPilot — Intelligent Task & Productivity Manager</title>

<!-- Google Fonts: Space Grotesk (display) + Inter (body) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
/* =========================================================
   TaskPilot — Single-file glassmorphism dark UI
   Phase 1: Hero, Auth (Login/Register), Dashboard (Tasks + Pomodoro)
   ========================================================= */

:root {
  /* Core dark palette with neon blue/violet accents */
  --bg-0: #07060f;
  --bg-1: #0c0a1c;
  --bg-2: #131029;
  --text: #e8ecff;
  --text-dim: #a4a8c7;
  --muted: #6a6e8c;

  /* Neon accents */
  --neon-blue: #4cc9ff;
  --neon-violet: #8a5cff;
  --neon-pink: #ff5cc8;
  --accent-grad: linear-gradient(135deg, #4cc9ff 0%, #8a5cff 60%, #ff5cc8 100%);

  /* Glass */
  --glass-bg: rgba(255, 255, 255, 0.05);
  --glass-bg-strong: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.12);
  --glass-shadow: 0 10px 40px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255,255,255,0.06);

  /* Priority colors */
  --p-high: #ff5c7a;
  --p-med:  #ffb84c;
  --p-low:  #4cd99a;

  /* Radii */
  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 22px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  height: 100%;
  background: var(--bg-0);
  color: var(--text);
  font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* -------- Animated background (aurora blobs + grid) -------- */
.bg-stage {
  position: fixed; inset: 0; z-index: -1; overflow: hidden;
  background:
    radial-gradient(1200px 700px at 80% -10%, rgba(138, 92, 255, 0.18), transparent 60%),
    radial-gradient(900px 600px at -10% 110%, rgba(76, 201, 255, 0.18), transparent 60%),
    linear-gradient(180deg, #07060f 0%, #0a0818 60%, #07060f 100%);
}
.bg-stage::before {
  content: ""; position: absolute; inset: -10%;
  background-image:
    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9), transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.9), transparent 75%);
}
.blob {
  position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.55;
  animation: float 18s ease-in-out infinite;
}
.blob.b1 { width: 520px; height: 520px; background: #4cc9ff; top: -120px; left: -80px; }
.blob.b2 { width: 460px; height: 460px; background: #8a5cff; bottom: -160px; right: -60px; animation-delay: -6s; }
.blob.b3 { width: 360px; height: 360px; background: #ff5cc8; top: 40%; left: 50%; transform: translate(-50%,-50%); opacity: 0.35; animation-delay: -12s; }

@keyframes float {
  0%, 100% { transform: translate(0,0) scale(1); }
  50% { transform: translate(40px, -30px) scale(1.06); }
}
.blob.b3 { animation-name: float3; }
@keyframes float3 {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-46%, -54%) scale(1.08); }
}

/* -------- Glass + utility -------- */
.glass {
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  box-shadow: var(--glass-shadow);
  border-radius: var(--r-md);
}
.container { max-width: 1240px; margin: 0 auto; padding: 0 28px; }

/* -------- Navbar -------- */
.nav {
  position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
  width: calc(100% - 32px); max-width: 1240px;
  z-index: 50;
  padding: 12px 20px;
  display: flex; align-items: center; justify-content: space-between;
  border-radius: 999px;
}
.brand {
  display: flex; align-items: center; gap: 10px;
  font-family: 'Space Grotesk', sans-serif; font-weight: 700; letter-spacing: -0.02em;
}
.brand .logo {
  width: 34px; height: 34px; border-radius: 10px;
  background: var(--accent-grad);
  display: grid; place-items: center;
  box-shadow: 0 6px 22px rgba(138,92,255,0.45);
}
.brand .logo i { color: #0b0a1a; font-size: 16px; }
.brand .name { font-size: 17px; }
.brand .name span { background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

.nav ul { display: flex; gap: 6px; list-style: none; }
.nav ul a {
  color: var(--text-dim); text-decoration: none; font-size: 14px; font-weight: 500;
  padding: 8px 14px; border-radius: 999px; transition: color .2s ease, background-color .2s ease;
}
.nav ul a:hover { color: #fff; background: rgba(255,255,255,0.06); }
.nav ul a.active { color: #fff; background: rgba(255,255,255,0.08); }
.nav-actions { display: flex; gap: 8px; align-items: center; }
.nav-toggle { display: none; background: transparent; border: 0; color: #fff; font-size: 20px; cursor: pointer; }

/* -------- Buttons -------- */
.btn {
  appearance: none; border: 0; cursor: pointer;
  font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14px;
  padding: 11px 18px; border-radius: 999px;
  display: inline-flex; align-items: center; gap: 8px;
  transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s ease, background-color .25s ease, color .25s ease, border-color .25s ease;
  position: relative; overflow: hidden;
  color: #fff;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
}
.btn:hover { transform: translateY(-1px); background: rgba(255,255,255,0.1); }
.btn:active { transform: translateY(0); }
.btn .fa-arrow-right { transition: transform .25s ease; }
.btn:hover .fa-arrow-right { transform: translateX(3px); }

.btn-primary {
  background: var(--accent-grad);
  color: #0a0918;
  border: 0;
  box-shadow: 0 8px 30px rgba(138,92,255,0.45), 0 0 0 1px rgba(255,255,255,0.15) inset;
}
.btn-primary:hover { box-shadow: 0 12px 40px rgba(138,92,255,0.6), 0 0 0 1px rgba(255,255,255,0.2) inset; }
.btn-primary::after {
  content: ""; position: absolute; inset: 0; border-radius: inherit;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.35) 50%, transparent 70%);
  transform: translateX(-100%);
  transition: transform .7s ease;
}
.btn-primary:hover::after { transform: translateX(100%); }

.btn-ghost { background: transparent; border: 1px solid rgba(255,255,255,0.16); }
.btn-ghost:hover { background: rgba(255,255,255,0.06); }

.btn-sm { padding: 8px 14px; font-size: 13px; }
.btn-icon { width: 36px; height: 36px; padding: 0; justify-content: center; border-radius: 10px; }

/* -------- Sections -------- */
section { padding: 120px 0 60px; }
.section-inner { padding-top: 20px; }

/* Hero */
.hero {
  min-height: 100vh;
  display: flex; align-items: center; padding-top: 120px; padding-bottom: 60px;
  position: relative;
}
.hero-grid {
  display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 60px; align-items: center;
}
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 12px; border-radius: 999px;
  background: rgba(76,201,255,0.08);
  border: 1px solid rgba(76,201,255,0.25);
  font-size: 12px; color: var(--neon-blue);
  font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;
}
.eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--neon-blue); box-shadow: 0 0 12px var(--neon-blue); animation: pulse 1.6s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.45} }

.hero h1 {
  margin-top: 18px;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700; line-height: 1.02; letter-spacing: -0.03em;
  font-size: clamp(40px, 6.2vw, 72px);
}
.hero h1 .grad { background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero p.lead { margin-top: 22px; color: var(--text-dim); font-size: 17px; line-height: 1.65; max-width: 560px; }
.hero-cta { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; }
.hero-stats { margin-top: 38px; display: flex; gap: 28px; flex-wrap: wrap; }
.hero-stats .stat .v { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; }
.hero-stats .stat .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }

/* Hero floating card preview */
.hero-card {
  padding: 22px;
  border-radius: var(--r-lg);
  animation: floatY 6s ease-in-out infinite;
}
@keyframes floatY { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-10px); } }

.mini-task {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px; border-radius: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  margin-top: 10px;
}
.mini-task .pill { font-size: 10px; padding: 3px 8px; border-radius: 999px; font-weight: 600; }
.mini-task .title { font-weight: 500; }
.mini-task .meta { color: var(--muted); font-size: 12px; margin-left: auto; }
.pill-high { background: rgba(255,92,122,0.15); color: var(--p-high); border: 1px solid rgba(255,92,122,0.3); }
.pill-med  { background: rgba(255,184,76,0.15); color: var(--p-med);  border: 1px solid rgba(255,184,76,0.3); }
.pill-low  { background: rgba(76,217,154,0.15); color: var(--p-low);  border: 1px solid rgba(76,217,154,0.3); }

.hero-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.hero-card-head .h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; }
.hero-card-head .dots { display: flex; gap: 6px; }
.hero-card-head .dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,0.1); }
.hero-card-head .dots span:first-child { background: #ff5c7a; }
.hero-card-head .dots span:nth-child(2) { background: #ffb84c; }
.hero-card-head .dots span:nth-child(3) { background: #4cd99a; }

/* -------- Auth (Login / Register) -------- */
.auth-wrap {
  display: grid; place-items: center; min-height: calc(100vh - 80px);
}
.auth-card { width: 100%; max-width: 460px; padding: 32px; border-radius: var(--r-lg); }
.auth-card h2 {
  font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700;
  letter-spacing: -0.02em;
}
.auth-card p.sub { color: var(--text-dim); margin-top: 6px; font-size: 14px; }
.field { margin-top: 16px; position: relative; }
.field label { font-size: 12px; color: var(--text-dim); letter-spacing: .04em; text-transform: uppercase; }
.field .ctrl {
  margin-top: 6px;
  display: flex; align-items: center; gap: 10px;
  padding: 12px 14px; border-radius: 12px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  transition: border-color .2s ease, background-color .2s ease, box-shadow .2s ease;
}
.field .ctrl:focus-within {
  border-color: rgba(138,92,255,0.6);
  box-shadow: 0 0 0 3px rgba(138,92,255,0.18);
  background: rgba(255,255,255,0.06);
}
.field .ctrl i { color: var(--text-dim); width: 16px; text-align: center; }
.field input, .field select, .field textarea {
  flex: 1; background: transparent; border: 0; outline: none; color: #fff;
  font-family: inherit; font-size: 14px;
}
.field input::placeholder { color: var(--muted); }
.field .error { color: #ff8aa0; font-size: 12px; margin-top: 6px; min-height: 14px; display: block; }

.auth-actions { margin-top: 22px; display: flex; gap: 10px; align-items: center; }
.auth-foot { margin-top: 18px; font-size: 13px; color: var(--text-dim); text-align: center; }
.auth-foot a { color: var(--neon-blue); text-decoration: none; font-weight: 500; }
.auth-foot a:hover { text-decoration: underline; }

/* -------- Dashboard -------- */
.dash {
  display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px;
}
.panel { padding: 22px; border-radius: var(--r-lg); }
.panel h3 {
  font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 600;
  display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
}
.panel h3 .ico {
  width: 30px; height: 30px; border-radius: 8px;
  background: rgba(138,92,255,0.18); color: var(--neon-violet);
  display: grid; place-items: center; font-size: 13px;
}

/* Task form */
.task-form { display: grid; grid-template-columns: 1fr; gap: 10px; }
.task-form .row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }

/* Task list */
.task-filters { display: flex; gap: 6px; flex-wrap: wrap; margin: 4px 0 14px; }
.chip {
  padding: 6px 12px; border-radius: 999px; font-size: 12px; cursor: pointer;
  border: 1px solid rgba(255,255,255,0.12); color: var(--text-dim);
  background: rgba(255,255,255,0.03);
  transition: all .2s ease;
}
.chip:hover { color: #fff; }
.chip.active { color: #0a0918; background: var(--accent-grad); border-color: transparent; font-weight: 600; }

.task-list { display: flex; flex-direction: column; gap: 10px; }
.task {
  display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
  padding: 14px 16px; border-radius: 14px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
  transition: transform .2s ease, background-color .2s ease, border-color .2s ease;
  animation: taskIn .35s ease both;
}
@keyframes taskIn { from { opacity: 0; transform: translateY(6px); } to { opacity:1; transform: translateY(0);} }
.task:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); transform: translateY(-1px); }
.task .check {
  width: 22px; height: 22px; border-radius: 7px;
  border: 1.5px solid rgba(255,255,255,0.25);
  display: grid; place-items: center; cursor: pointer;
  transition: all .2s ease;
}
.task .check:hover { border-color: var(--neon-violet); }
.task.done .check { background: var(--accent-grad); border-color: transparent; }
.task.done .check i { color: #0a0918; font-size: 11px; }
.task.done .title { text-decoration: line-through; color: var(--muted); }
.task .title { font-weight: 500; }
.task .meta-row { display: flex; gap: 8px; align-items: center; margin-top: 4px; flex-wrap: wrap; }
.task .cat {
  font-size: 10.5px; padding: 3px 8px; border-radius: 999px; text-transform: uppercase;
  letter-spacing: .06em; background: rgba(76,201,255,0.12); color: var(--neon-blue); border: 1px solid rgba(76,201,255,0.25);
}
.task .date { font-size: 11.5px; color: var(--muted); }
.task .actions { display: flex; gap: 6px; }
.task .actions button {
  width: 32px; height: 32px; border-radius: 8px;
  background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
  color: var(--text-dim); cursor: pointer; transition: all .2s ease;
}
.task .actions button:hover { color: #fff; background: rgba(255,255,255,0.1); transform: translateY(-1px); }
.task .actions .del:hover { color: #ff8aa0; border-color: rgba(255,138,160,0.3); }

.empty {
  text-align: center; padding: 30px 10px; color: var(--muted); font-size: 14px;
  border: 1px dashed rgba(255,255,255,0.1); border-radius: 14px;
}

/* Pomodoro */
.pomo { text-align: center; }
.pomo-ring {
  position: relative; width: 220px; height: 220px; margin: 8px auto 18px;
  display: grid; place-items: center;
}
.pomo-ring svg { transform: rotate(-90deg); width: 220px; height: 220px; }
.pomo-ring .track { stroke: rgba(255,255,255,0.08); }
.pomo-ring .prog {
  stroke: url(#grad);
  stroke-linecap: round;
  transition: stroke-dashoffset .5s ease;
  filter: drop-shadow(0 0 10px rgba(138,92,255,0.5));
}
.pomo-time {
  position: absolute; inset: 0; display: grid; place-items: center;
  font-family: 'Space Grotesk', sans-serif; font-size: 44px; font-weight: 700; letter-spacing: -0.02em;
}
.pomo-mode { color: var(--text-dim); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; margin-top: -8px; }
.pomo-actions { display: flex; gap: 8px; justify-content: center; margin-top: 6px; }
.pomo-modes { display: flex; gap: 6px; justify-content: center; margin-top: 12px; }
.pomo-modes .chip.active { color: #fff; background: rgba(138,92,255,0.25); border-color: rgba(138,92,255,0.5); }

/* Topbar inside dashboard */
.dash-topbar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 22px;
}
.dash-topbar .hello { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
.dash-topbar .hello span { background: var(--accent-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
.dash-topbar .sub { color: var(--text-dim); font-size: 13px; margin-top: 2px; }

/* -------- Toasts -------- */
.toasts {
  position: fixed; bottom: 24px; right: 24px; z-index: 200;
  display: flex; flex-direction: column; gap: 10px; pointer-events: none;
}
.toast {
  pointer-events: auto;
  min-width: 280px; max-width: 360px;
  padding: 12px 14px; border-radius: 12px;
  display: flex; align-items: center; gap: 10px;
  background: rgba(20, 16, 40, 0.9);
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 14px 40px rgba(0,0,0,0.5);
  backdrop-filter: blur(20px);
  animation: toastIn .35s ease both;
}
.toast.out { animation: toastOut .35s ease forwards; }
@keyframes toastIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
@keyframes toastOut { to { opacity: 0; transform: translateX(20px); } }
.toast .ic {
  width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; font-size: 13px;
}
.toast.success .ic { background: rgba(76,217,154,0.18); color: var(--p-low); }
.toast.error   .ic { background: rgba(255,92,122,0.18); color: var(--p-high); }
.toast.info    .ic { background: rgba(76,201,255,0.18); color: var(--neon-blue); }
.toast .msg .t { font-weight: 600; font-size: 13px; }
.toast .msg .d { color: var(--text-dim); font-size: 12px; }

/* -------- Page switching -------- */
.page { display: none; animation: pageIn .45s ease both; }
.page.active { display: block; }
@keyframes pageIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

/* -------- Responsive -------- */
@media (max-width: 960px) {
  .hero-grid { grid-template-columns: 1fr; gap: 40px; }
  .dash { grid-template-columns: 1fr; }
  .nav ul { display: none; position: absolute; top: 64px; left: 0; right: 0;
    flex-direction: column; gap: 0; padding: 10px; border-radius: 16px;
    background: rgba(15,12,30,0.95); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); }
  .nav ul.open { display: flex; }
  .nav ul a { padding: 12px 14px; border-radius: 10px; }
  .nav-toggle { display: inline-flex; }
  .task-form .row { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
  .container { padding: 0 18px; }
  .nav { padding: 10px 14px; }
  .brand .name { display: none; }
  .hero { padding-top: 100px; }
  .hero-stats { gap: 18px; }
  .auth-card { padding: 24px; }
  .task { grid-template-columns: auto 1fr; }
  .task .actions { grid-column: 1 / -1; justify-content: flex-end; }
}

/* Focus accessibility */
:focus-visible { outline: 2px solid var(--neon-violet); outline-offset: 2px; border-radius: 8px; }

/* Custom selection */
::selection { background: rgba(138,92,255,0.45); color: #fff; }

/* Scrollbar */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.16); }
</style>
</head>
<body>

<!-- Animated background -->
<div class="bg-stage" aria-hidden="true">
  <div class="blob b1"></div>
  <div class="blob b2"></div>
  <div class="blob b3"></div>
</div>

<!-- Navigation -->
<nav class="nav glass" data-testid="main-nav">
  <a href="#home" class="brand" data-testid="brand-logo" onclick="navigate('home', event)">
    <span class="logo"><i class="fa-solid fa-rocket"></i></span>
    <span class="name">Task<span>Pilot</span></span>
  </a>
  <ul id="navMenu" data-testid="nav-menu">
    <li><a href="#home"  data-page="home"  class="active" onclick="navigate('home', event)"  data-testid="nav-home">Home</a></li>
    <li><a href="#login" data-page="login" onclick="navigate('login', event)" data-testid="nav-login">Login</a></li>
    <li><a href="#register" data-page="register" onclick="navigate('register', event)" data-testid="nav-register">Register</a></li>
    <li><a href="#dashboard" data-page="dashboard" onclick="navigate('dashboard', event)" data-testid="nav-dashboard">Dashboard</a></li>
